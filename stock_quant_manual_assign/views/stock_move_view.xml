<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_picking_manual_quants_form_view" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="lot_ids" position="after">
                <button
                    name="%(assign_manual_quants_action)d"
                    type="action"
                    icon="sell"
                    title="Manual Quants"
                    options='{"warn": true}'
                    invisible="picking_code == 'incoming' or state not in ('confirmed','assigned','partially_available')"
                />
            </field>
        </field>
    </record>
</odoo>
